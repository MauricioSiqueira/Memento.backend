{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=memento;Username=mauriciobernardo"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "Container": "memento-arquivos"
  },
  "Jwt": {
    "Issuer": "Memento.Api",
    "Audience": "Memento.App",
    "Key": "dev-only-memento-chave-hmac-troque-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimit": {
    "Auth": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Upload": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 100, "WindowSeconds": 60 }
  },
  "Upload": {
    "MaxBytes": 10485760,
    "MaxArquivosPorRequisicao": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8081" ]
  }
}
